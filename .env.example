# 闲鱼 AI 助手 — 环境变量配置
# 复制此文件为 .env 并填入真实值

# === 闲鱼登录 ===
# 从浏览器 DevTools → Application → Cookies → 复制所有 Cookie
XIANYU_COOKIES=your_cookies_here

# === 监控设置 ===
MONITOR_INTERVAL=300
MAX_ITEMS_PER_KEYWORD=20

# === 飞书通知（可选） ===
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# === 服务 ===
HOST=0.0.0.0
PORT=8000

# === 数据库 ===
DATABASE_URL=sqlite+aiosqlite:///data/xianyu.db
