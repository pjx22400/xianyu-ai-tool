# 闲鱼 AI 助手 — 环境变量配置
# 复制此文件为 .env 并填入真实值

# === AI (DeepSeek) ===
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# === 闲鱼登录 ===
# 方法1: 运行 python scripts/login.py 自动获取
# 方法2: 浏览器打开 goofish.com → F12 → Application → Cookies → 复制所有 Cookie
XIANYU_COOKIES=your_cookies_here

# === 监控设置 ===
MONITOR_INTERVAL=300
MAX_ITEMS_PER_KEYWORD=20

# === 飞书通知（可选） ===
FEISHU_WEBHOOK=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# === 服务 ===
HOST=0.0.0.0
PORT=8000

# === 数据库 ===
DATABASE_URL=sqlite+aiosqlite:///data/xianyu.db
